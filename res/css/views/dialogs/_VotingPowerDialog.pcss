.mx_VotingPowerDialog {
    .mx_VotingPowerDialog_content {
        padding: 24px;
        text-align: center;
    }
    
    .mx_VotingPowerDialog_message {
        font-size: 16px;
        color: var(--primary-content);
        margin-bottom: 24px;
        line-height: 1.5;
    }
    
    .mx_VotingPowerDialog_actions {
        display: flex;
        gap: 12px;
        justify-content: center;
    }
    
    .mx_VotingPowerDialog_voteButton {
        min-width: 120px;
    }
    
    .mx_VotingPowerDialog_cancelButton {
        min-width: 120px;
    }
}
